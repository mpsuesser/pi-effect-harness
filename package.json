{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "pi-effect-enforcer",
  "version": "0.1.0",
  "description": "a harness specifically for writing Effect v4 code",
  "keywords": [
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/mpsuesser/pi-effect-enforcer#readme",
  "bugs": {
    "url": "https://github.com/mpsuesser/pi-effect-enforcer/issues"
  },
  "license": "MIT",
  "author": "Marc Suesser",
  "repository": {
    "type": "git",
    "url": "https://github.com/mpsuesser/pi-effect-enforcer.git"
  },
  "files": [
    "src",
    "skills",
    "patterns",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "oxlint -c oxlintrc.json",
    "test": "vitest run",
    "typecheck": "tsgo",
    "check": "dprint fmt && oxlint -c oxlintrc.json && tsgo",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.40.5",
    "@effect/platform-node": "4.0.0-beta.50",
    "effect": "4.0.0-beta.50",
    "picomatch": "^4.0.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.4.0",
    "@effect/vitest": "4.0.0-beta.50",
    "@mariozechner/pi-coding-agent": "^0.67.1",
    "@types/bun": "^1.3.10",
    "@typescript/native-preview": "^7.0.0-dev.20260415.1",
    "dprint": "^0.49.0",
    "oxlint": "^1.58.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "overrides": {
    "effect": "4.0.0-beta.50"
  },
  "packageManager": "bun@1.3.11",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
