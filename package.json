{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "pi-effect-harness-workspace",
  "version": "0.1.0",
  "description": "workspace root for the pi-effect-harness extension and the pi-harness-kit library",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "harnesses/*",
    "sandboxes/*"
  ],
  "pi": {
    "extensions": [
      "./harnesses/effect/src/index.ts"
    ],
    "skills": [
      "./harnesses/effect/skills"
    ]
  },
  "scripts": {
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "oxlint -c oxlintrc.json",
    "test": "vitest run",
    "typecheck": "tsgo",
    "check": "dprint fmt && oxlint -c oxlintrc.json && tsgo",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.4.0",
    "@effect/vitest": "catalog:",
    "@mariozechner/pi-coding-agent": "^0.67.1",
    "@types/bun": "^1.3.12",
    "@typescript/native-preview": "^7.0.0-dev.20260415.1",
    "dprint": "^0.49.0",
    "oxlint": "^1.58.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "catalog": {
    "@ast-grep/napi": "^0.40.5",
    "@effect/platform-node": "4.0.0-beta.52",
    "@effect/vitest": "4.0.0-beta.52",
    "effect": "4.0.0-beta.52"
  },
  "overrides": {
    "effect": "4.0.0-beta.52"
  },
  "packageManager": "bun@1.3.12"
}
