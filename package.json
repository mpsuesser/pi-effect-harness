{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "pi-effect-harness-workspace",
  "version": "0.1.0",
  "description": "workspace root for the pi-effect-harness extension and the pi-harness-kit library",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "harnesses/*",
    "sandboxes/*"
  ],
  "pi": {
    "extensions": [
      "./harnesses/effect/src/index.ts"
    ],
    "skills": [
      "./harnesses/effect/skills"
    ]
  },
  "scripts": {
    "fmt": "dprint fmt",
    "fmt:check": "dprint check",
    "lint": "oxlint -c oxlintrc.json",
    "test": "vitest run",
    "typecheck": "tsgo",
    "check": "dprint fmt && oxlint -c oxlintrc.json && tsgo",
    "build:publishable": "bun run scripts/build-publishable.ts",
    "publish:dry": "bun run scripts/build-publishable.ts && cd harnesses/effect/dist && bun publish --dry-run",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.7.4",
    "@effect/vitest": "catalog:",
    "@mariozechner/pi-coding-agent": "^0.73.1",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260519.1",
    "dprint": "^0.54.0",
    "oxlint": "^1.66.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "catalog": {
    "@ast-grep/napi": "^0.42.3",
    "@effect/platform-node": "4.0.0-beta.69",
    "@effect/vitest": "4.0.0-beta.69",
    "effect": "4.0.0-beta.69"
  },
  "overrides": {
    "effect": "4.0.0-beta.69"
  },
  "packageManager": "bun@1.3.14"
}
